rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // თითო მომხმარებელს მხოლოდ საკუთარი დოკუმენტი users/{uid} ეკუთვნის
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'at'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.at is number;
    }
  }
}
